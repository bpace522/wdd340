<section class="vehicle-detail-page">

  <!-- Vehicle Image -->
  <div class="vehicle-images">
    <img
      src="<%= vehicle.inv_image %>"
      alt="<%= vehicle.inv_year %> <%= vehicle.inv_make %> <%= vehicle.inv_model %>"
      class="main-vehicle-image"
    >
  </div>

  <!-- Vehicle Information -->
  <div class="vehicle-info">

    <!-- Main Heading -->
    <h1>
      <%= vehicle.inv_year %>
      <%= vehicle.inv_make %>
      <%= vehicle.inv_model %>
    </h1>

    <!-- Price -->
    <p class="price">
      Price: $<%= Number(vehicle.inv_price).toLocaleString("en-US") %>
    </p>

    <!-- Specs -->
    <ul class="vehicle-specs">
      <li>
        <strong>Mileage:</strong>
        <%= Number(vehicle.inv_miles).toLocaleString("en-US") %> miles
      </li>
      <li>
        <strong>Exterior Color:</strong>
        <%= vehicle.inv_color %>
      </li>
    </ul>

    <!-- Description -->
    <p class="description">
      <strong>Vehicle Description:</strong>
      <%= vehicle.inv_description %>
    </p>
    <div class="vehicle-actions">
      <button>Start My Purchase</button>
      <button class="secondary">Schedule Test Drive</button>
    </div>

  </div>

</section>
