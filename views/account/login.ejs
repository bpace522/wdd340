<div class="login-container">
  <form class="login-form" action="/account/login" method="post">
    <h1><%= title %></h1>
    <%- messages() %>
    
    <label for="account_email">Email</label>
    <input type="email" id="account_email" name="account_email" required>
    
    <label for="account_password">Password</label>
    <input type="password" id="account_password" name="account_password" required required pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
    <p id="password-rules">
          Password requirements:
          <br>• 12 characters minimum
          <br>• at least 1 capital letter
          <br>• at least 1 number
          <br>• at least 1 special character
    </p>
    
    <input type="submit" value="Log In">
    
    <p class="register-link">
      Don't have an account? <a href="/account/register">Register here</a>
    </p>
  </form>
</div>