<div class="register-container">
  <div class="register-form">
    <h1><%= title %></h1>
    <%- messages() %>
    <% if (errors) { %>
      <ul class="notice">
    <% errors.array().forEach(error => { %>
      <li><%= error.msg %></li>
    <%  }) %>
    </ul>
    <% } %>
    <form action="/account/register" method="post">
      <fieldset>
        <legend>Create an Account</legend>
        <label for="account_firstname">First Name <span aria-hidden="true">*</span></label>
        <input
          type="text"
          id="account_firstname"
          name="account_firstname"
          required
          value="<%= locals.account_firstname %>"
        >
        <label for="account_lastname">Last Name <span aria-hidden="true">*</span></label>
        <input
          type="text"
          id="account_lastname"
          name="account_lastname"
          required
          value="<%= locals.account_lastname %>"
        >
        <label for="account_email">Email <span aria-hidden="true">*</span></label>
        <input
          type="email"
          id="account_email"
          name="account_email"
          required
          value="<%= locals.account_email %>"
        >
        <label for="account_password">Password <span aria-hidden="true">*</span></label>
        <input
          type="password"
          id="account_password"
          name="account_password"
          required
          minlength="12"
          aria-describedby="password-rules"
          required pattern="^(?=.*\d)(?=.*[a-z])(?=.*[A-Z])(?=.*[^a-zA-Z0-9])(?!.*\s).{12,}$"
        >
        <p id="password-rules">
          Password requirements:
          <br>• 12 characters minimum
          <br>• at least 1 capital letter
          <br>• at least 1 number
          <br>• at least 1 special character
        </p>
        <button type="button" id="togglePassword" aria-controls="account_password" aria-pressed="false">
          Show Password
        </button>
        <button type="submit">Register</button>
      </fieldset>
    </form>
    <p class="login-link">
      Already have an account?
      <a href="/account/login">Log in</a>
    </p>
  </div>
</div>
<script>
  const pwd = document.getElementById("account_password")
  const btn = document.getElementById("togglePassword")
  btn.addEventListener("click", () => {
    const isHidden = pwd.getAttribute("type") === "password"
    pwd.setAttribute("type", isHidden ? "text" : "password")
    btn.textContent = isHidden ? "Hide Password" : "Show Password"
    btn.setAttribute("aria-pressed", isHidden ? "true" : "false")
  })
</script>